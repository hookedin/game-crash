{
  "name": "@hookedin/game-crash",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": "github:hookedin/game-crash",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "hookedin-game build",
    "dev": "wrangler dev",
    "typecheck": "tsc && tsc -p server",
    "test": "npm run typecheck && npm run build && node --import tsx --test test/*.test.ts server/*.test.ts",
    "demo": "npm run build && node --import tsx test/harness.ts",
    "chain": "node --env-file-if-exists=.dev.vars --import tsx scripts/chain.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hookedin/play": "git+https://github.com/hookedin/play.git#main",
    "ethers": "6.17.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "@types/node": "26.6.4",
    "playwright-core": "1.63.0",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "wrangler": "4.149.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "workerd": true
  }
}
